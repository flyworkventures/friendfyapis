# Core
PORT=3000
JWT_SECRET=key

# MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Abonelik / RevenueCat
# İlk girişte otomatik cihaz denemesi (varsayılan KAPALI). Deneme artık paywall
# satın almasıyla (App Store/Play tanıtım teklifi) başlar.
DEVICE_FREE_TRIAL_ENABLED=false
# RevenueCat Dashboard → Integrations → Webhooks içinde ayarlanan Authorization
# header değeriyle birebir aynı olmalı (webhook kimlik doğrulaması).
REVENUECAT_WEBHOOK_AUTH=

# Voice streaming feature flag
VOICE_STREAMING_ENABLED=true
VIDEO_CALL_ENABLED=false
REALTIME_V2_ENABLED=true
REALTIME_WS_PATH=/realtime
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
ELEVENLABS_VOICE_CHAT_MODEL=eleven_turbo_v2_5
ENABLE_RHUBARB_VISEME=true
# Proje içi kurulum: bash scripts/install-rhubarb-mac.sh
RHUBARB_BIN=./tools/rhubarb/rhubarb
VISEME_TIME_SCALE=1.0
VOICE_DEBUG_LOGS=false
TTS_STREAMING_ENABLED=false

# STT provider config
STT_PROVIDER=openai-whisper
VOICE_DEFAULT_LANGUAGE=tr-TR
VOICE_AUDIO_CODEC=pcm16le
VOICE_AUDIO_SAMPLE_RATE=16000
VOICE_AUDIO_CHANNELS=1
VOICE_AUDIO_FRAME_MS=20

# WebRTC transport (opsiyonel)
WEBRTC_ENABLED=false
# JSON array string, örn:
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
WEBRTC_ICE_SERVERS=

# Deepgram (streaming STT) - opsiyonel
DEEPGRAM_API_KEY=

# AI pipeline config
# echo | webhook | openai
VOICE_AI_MODE=openai
VOICE_AI_WEBHOOK_URL=

# OpenAI (Whisper + GPT)
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_STT_PROMPT=Turkce konusmayi dogru yaz. Belirsiz sesi uydurma.
OPENAI_STT_TEMPERATURE=0
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_CHAT_TEMPERATURE=0.2

# Metin sohbet (n8n yerine doğrudan OpenAI)
CHAT_REPLY_MODEL=gpt-4o-mini
CHAT_VISION_MODEL=gpt-4o-mini
CHAT_REPLY_TEMPERATURE=0.55
CHAT_MAX_OUTPUT_TOKENS=320
CHAT_HISTORY_LIMIT=48
CHAT_MAX_BUBBLES=3
CHAT_MULTI_BUBBLE_RATE=0.12
CHAT_BUBBLE_MAX_SENTENCES=3
CHAT_BUBBLE_MAX_CHARS=280
MEMORY_REFRESH_MIN_MESSAGES=20
MEMORY_REFRESH_EVERY_N=8
MEMORY_SUMMARY_MAX_CHARS=1400
# CHAT_MEMORY_MODEL=gpt-4o-mini
STT_MIN_TRANSCRIPT_CHARS=2
STT_MIN_AUDIO_BYTES=3200
VOICE_VAD_SILENCE_MS=1200

# ElevenLabs TTS (streaming)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_ID=

# Viseme (rhubarb + ffmpeg)
VISEME_ENABLED=false
VISEME_BLOCKING=true
VISEME_PROVIDER=rhubarb
VISEME_MIN_GAP_SEC=0.04
VISEME_FFMPEG_BIN=ffmpeg
VISEME_RHUBARB_BIN=/opt/rhubarb/rhubarb

# OneSignal (proaktif karakter mesajı push — opsiyonel)
# Dashboard → Settings → Keys & IDs
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
